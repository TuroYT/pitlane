{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "platformAutomerge": true,
  "automergeType": "pr",
  "vulnerabilityAlerts": {
    "description": "Security fixes are proposed as soon as they are published, outside the weekly schedule, and never wait in a group",
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "groupName": null,
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "description": "Images pinned as \"name:tag@sha256:digest\" outside Dockerfiles (run-time images, setup-qemu-action input)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal/pool/images\\.go$/",
        "/^\\.github/workflows/release\\.yml$/"
      ],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9./-]*):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Runner image tag used by dev builds: the latest Pitlane release",
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal/pool/images\\.go$/"
      ],
      "matchStrings": [
        "devRunnerTag = \"(?<currentValue>v[0-9][^\"]*)\""
      ],
      "depNameTemplate": "ghcr.io/turoyt/pitlane-runner",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Tool versions pinned as build ARGs in the runner image, annotated with a \"# renovate:\" comment (their checksums are verified at build time)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/runner/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-]+))?\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Go tools run with `go run` at a version pinned in the Makefile, annotated with a \"# renovate:\" comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n[A-Z0-9_]+_VERSION \\?= (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep the runner base image and the fallback runner image on the same version",
      "matchDepNames": [
        "ghcr.io/actions/actions-runner"
      ],
      "groupName": "actions-runner",
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "binfmt release tags are qemu-vX.Y.Z",
      "matchDepNames": [
        "tonistiigi/binfmt"
      ],
      "versioning": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "The runner image follows a Node.js LTS line: a new major (odd ones are never LTS) waits for approval on the dependency dashboard",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Pitlane's own images are released from this repository: proposed right after a release, outside the weekly schedule",
      "matchDepNames": [
        "ghcr.io/turoyt/pitlane",
        "ghcr.io/turoyt/pitlane-runner"
      ],
      "groupName": "pitlane release images",
      "minimumReleaseAge": null,
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": "Actions are pinned by digest: minor, patch and digest updates go in one weekly PR, merged once CI is green",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Runtime dependencies of the UI (shipped in the binary): grouped, merged by a maintainer",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/**"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "web dependencies (non-major)"
    },
    {
      "description": "Build and test tooling of the UI: grouped, merged once CI is green",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/**"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "web dev dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "The docs site only has build dependencies: grouped, merged once CI is green",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "site/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "docs site dependencies (non-major)",
      "automerge": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go modules (non-major)"
    },
    {
      "description": "The docs site refuses dependencies published less than 14 days ago (pnpm minimumReleaseAge): wait as long before proposing them.",
      "matchFileNames": [
        "site/**"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Image digests (same tag, rebuilt upstream): merged once CI is green",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "binfmt is only used by the release workflow, which pull request CI does not run: a maintainer merges its digest updates",
      "matchDepNames": [
        "tonistiigi/binfmt"
      ],
      "automerge": false
    },
    {
      "description": "Go tools of the Makefile: a new golangci-lint can report new issues, so a maintainer merges it",
      "matchFileNames": [
        "Makefile"
      ],
      "groupName": "go tools"
    },
    {
      "description": "vue-tsc 3.x does not support TypeScript 7 (ERR_PACKAGE_PATH_NOT_EXPORTED on ./lib/tsc): wait until it does.",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
