{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "description": "Images pinned as \"name:tag@sha256:digest\" outside Dockerfiles (run-time images, setup-qemu-action input)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal/pool/images\\.go$/",
        "/^\\.github/workflows/release\\.yml$/"
      ],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9./-]*):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Runner image tag used by dev builds: the latest Pitlane release",
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal/pool/images\\.go$/"
      ],
      "matchStrings": [
        "devRunnerTag = \"(?<currentValue>v[0-9][^\"]*)\""
      ],
      "depNameTemplate": "ghcr.io/turoyt/pitlane-runner",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Tool versions pinned as build ARGs in the runner image, annotated with a \"# renovate:\" comment (their checksums are verified at build time)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/runner/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-]+))?\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the runner base image and the fallback runner image on the same version",
      "matchDepNames": [
        "ghcr.io/actions/actions-runner"
      ],
      "groupName": "actions-runner",
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "binfmt release tags are qemu-vX.Y.Z",
      "matchDepNames": [
        "tonistiigi/binfmt"
      ],
      "versioning": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "The runner image follows a Node.js LTS line: a new major (odd ones are never LTS) waits for approval on the dependency dashboard",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Pitlane's own images are released from this repository",
      "matchDepNames": [
        "ghcr.io/turoyt/pitlane",
        "ghcr.io/turoyt/pitlane-runner"
      ],
      "groupName": "pitlane release images",
      "minimumReleaseAge": null
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "web dependencies (non-major)"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go modules (non-major)"
    }
  ]
}
